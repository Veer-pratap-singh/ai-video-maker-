# Pexels API Key (for stock video & image search)
PEXELS_API_KEY=your_pexels_api_key_here

# Google Gemini API Key (for generating scripts automatically)
GEMINI_API_KEY=your_gemini_api_key_here

# Instagram Direct Authentication (using instagrapi)
INSTAGRAM_USERNAME=your_instagram_username_here
INSTAGRAM_PASSWORD=your_instagram_password_here
